<Window x:Class="VivLauncher.App.InstallationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Text[Manage]}" Style="{StaticResource AppWindow}" Width="680" Height="490" MinWidth="540" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding Text[Manage]}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Text[ManageHint]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Installs}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="InstallationList">
            <ListBox.ItemTemplate><DataTemplate>
                <Border CornerRadius="6" BorderThickness="1" Padding="14" Margin="0,4" ToolTip="{Binding Path}">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Style.Triggers><DataTrigger Binding="{Binding Unavailable}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningLine}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,12,0" /><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource WarningInk}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding Unavailable, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Content="{Binding DataContext.Text[SetDefault], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding Available, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Action}" />
                            <Button Content="{Binding DataContext.Text[RemoveInstall], RelativeSource={RelativeSource AncestorType=Window}}" Click="RemoveClick" Visibility="{Binding Removable, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Action}" AutomationProperties.AutomationId="RemoveInstall" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,12" TextWrapping="Wrap" MaxHeight="56" ToolTip="{Binding Status}" />
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="{Binding Text[Close]}" IsCancel="True" Style="{StaticResource Action}" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{Binding Text[UndoRemoval]}" Command="{Binding UndoRemovalCommand}" IsEnabled="{Binding IsIdle}" Visibility="{Binding CanUndoRemoval, Converter={StaticResource BoolVisibility}}" Style="{StaticResource LinkButton}" Margin="10,0,0,0" AutomationProperties.AutomationId="UndoRemoval" />
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}"><Button Content="{Binding Text[AddPath]}" Style="{StaticResource Primary}" Click="AddClick" AutomationProperties.AutomationId="AddPath" /><Button Content="{Binding Text[Scan]}" Command="{Binding ScanCommand}" Style="{StaticResource Action}" Margin="10,0,0,0" AutomationProperties.AutomationId="Scan" /></StackPanel>
        </DockPanel>
    </Grid>
</Window>
