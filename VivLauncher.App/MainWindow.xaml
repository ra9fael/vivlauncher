<Window x:Class="VivLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VivLauncher.App"
        Title="Vivado Launcher" Style="{StaticResource AppWindow}" Icon="Resources/app.ico" Width="980" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnWindowKeyDown" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,16">
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Action}" Click="ManageClick" Content="{Binding Text[Manage]}" AutomationProperties.AutomationId="Manage" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Action}" Click="SettingsClick" Content="{Binding Text[Settings]}" AutomationProperties.AutomationId="Settings" Margin="0,0,8,0" />
                    <Grid MinWidth="144">
                        <ComboBox ItemsSource="{Binding Text.Options}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}" MinHeight="36" Padding="32,4,24,4"
                                  ItemContainerStyle="{StaticResource LanguageOption}" AutomationProperties.AutomationId="ToolbarLanguage"
                                  AutomationProperties.Name="{Binding Text[Language]}" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" />
                        <Path Width="17" Height="17" Stretch="Uniform" Data="M12,2 A10,10 0 1 1 11.999,2 Z M12,2 A4.5,10 0 1 1 11.999,2 Z M2,12 H22"
                              Stroke="{DynamicResource Ink}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Margin="9,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource BrandIcon}" Width="36" Height="36" Margin="0,0,12,0" />
                    <StackPanel><TextBlock Text="Vivado Launcher" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Text[Subtitle]}" Style="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                </StackPanel>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="34,10,42,10" MinHeight="42" AutomationProperties.Name="{Binding Text[Search]}" AutomationProperties.AutomationId="Search" PreviewKeyDown="OnSearchKeyDown" />
                    <Path Data="M10,6 A4,4 0 1 1 2,6 A4,4 0 1 1 10,6 M9,9 L14,14" Stroke="{DynamicResource MutedInk}" StrokeThickness="1.5" StrokeEndLineCap="Round" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding Text[Search]}" Foreground="{DynamicResource MutedInk}" Margin="37,0,45,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Ctrl F" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="1" Content="{Binding Text[Browse]}" Click="BrowseClick" Style="{StaticResource Action}" Margin="10,0,0,0" MinWidth="90" AutomationProperties.AutomationId="Browse" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="1" IsEnabled="{Binding Launching, Converter={x:Static local:BoolInverter.Instance}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="53*" MinWidth="280" /><ColumnDefinition Width="47*" MinWidth="300" /></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="24,20,18,12"><TextBlock Text="{Binding ProjectCount}" Style="{StaticResource Muted}" DockPanel.Dock="Right" /><Button Content="{Binding CleanLabel}" Command="{Binding CleanUnavailableRecentCommand}" Visibility="{Binding CanCleanUnavailable, Converter={StaticResource BoolVisibility}}" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Margin="0,0,12,0" FontSize="12" AutomationProperties.AutomationId="CleanUnavailable" /><TextBlock Text="{Binding Text[Recent]}" FontWeight="SemiBold" /></DockPanel>
                    <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" Background="Transparent" Margin="12,0,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="OnProjectDoubleClick" PreviewKeyDown="OnListKeyDown" AutomationProperties.AutomationId="Projects">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ListWidth}}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding IssueSummary}" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="10"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Warning}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningLine}" /></DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentInk}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentInk}" /><Setter TargetName="Card" Property="BorderThickness" Value="3,1,1,1" /><Setter TargetName="Card" Property="Padding" Value="8,10,10,10" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}" /></Trigger>
                                        <DataTrigger Binding="{Binding Warning}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource WarningSurface}" /></DataTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentInk}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Width="30" Height="34" VerticalAlignment="Top"><Path Data="M1,1 H8 L12,5 V16 H1 Z M8,1 V5 H12 M4,9 H9 M4,12 H9" Stroke="{DynamicResource AccentInk}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <local:HighlightTextBlock Value="{Binding NameHighlight}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" />
                                    <local:HighlightTextBlock Value="{Binding DirectoryHighlight}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" TextAlignment="Right" ToolTip="{Binding StatusText}" />
                                    <ItemsControl ItemsSource="{Binding Issues}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, StringFormat=⚠ {0}}" TextAlignment="Right" FontSize="11" Foreground="{DynamicResource WarningInk}" Margin="0,4,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding DataContext.Text[RemoveInstall], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveUnavailableRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding Available, Converter={StaticResource InverseVisibility}}" Style="{StaticResource LinkButton}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" ToolTip="{Binding Path}" AutomationProperties.AutomationId="RemoveUnavailableProject" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="30" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Text[DropHint]}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="8,18" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="{Binding Text[Current]}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding SelectedProject.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="CopyClick" ToolTip="{Binding Text[Copy]}" AutomationProperties.Name="{Binding Text[Copy]}" Style="{StaticResource LinkButton}" Margin="12,0,0,0"><Path Data="M3,11 H0 V0 H8 V3 M4,4 H12 V15 H4 Z" Stroke="{DynamicResource AccentInk}" /></Button>
                                <TextBox Text="{Binding SelectedProject.Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedInk}" Padding="0" FontSize="12" AutomationProperties.AutomationId="ProjectPath" />
                            </DockPanel>
                            <TextBlock Text="{Binding LastUsed}" Style="{StaticResource Muted}" Margin="0,12,0,25" />
                            <TextBlock Text="{Binding Text[OpenWith]}" Style="{StaticResource Label}" />
                            <Grid>
                            <ComboBox x:Name="VersionPicker" ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}" MinHeight="42" Padding="12,8" AutomationProperties.AutomationId="VersionPicker" AutomationProperties.Name="{Binding Text[OpenWith]}">
                                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource InstallOption}"><Setter Property="IsEnabled" Value="{Binding Available}" /><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningInk}" /></DataTrigger></Style.Triggers></Style></ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding Text[ChooseVersion]}" Foreground="{DynamicResource MutedInk}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedInstall}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            </Grid>
                            <TextBlock Text="{Binding SelectedInstall.Path}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectionSource}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.AutomationId="SelectionSource">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectionWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningInk}" /></DataTrigger></Style.Triggers><Setter Property="Foreground" Value="{DynamicResource MutedInk}" /></Style></TextBlock.Style>
                            </TextBlock>
                            <GroupBox AutomationProperties.AutomationId="ProjectIssues" AutomationProperties.Name="{Binding SelectedProject.IssueSummary}" Visibility="{Binding SelectedProject.Warning, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                                <GroupBox.Template><ControlTemplate TargetType="GroupBox">
                                    <Border Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource WarningLine}" BorderThickness="1" CornerRadius="4" Padding="10,6"><ContentPresenter /></Border>
                                </ControlTemplate></GroupBox.Template>
                                <ItemsControl ItemsSource="{Binding SelectedProject.Issues}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Label, StringFormat=⚠ {0}}" Foreground="{DynamicResource WarningInk}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource WarningInk}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                            <Button Content="{Binding BindLabel}" Command="{Binding BindCommand}" IsEnabled="{Binding CanBind}" Style="{StaticResource LinkButton}" Margin="0,8,0,16" AutomationProperties.AutomationId="Bind" />
                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12" />
                            <Expander Header="{Binding Text[Options]}" AutomationProperties.AutomationId="Options">
                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="{Binding Text[NoLog]}" IsChecked="{Binding NoLog}" Margin="0,0,0,10" />
                                    <CheckBox Content="{Binding Text[NoJournal]}" IsChecked="{Binding NoJournal}" Margin="0,0,0,14" />
                                    <TextBlock Text="{Binding Text[Arguments]}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="{Binding Text[Arguments]}" AutomationProperties.AutomationId="Arguments" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding Text[ChooseProject]}" Style="{StaticResource Muted}" Margin="32" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding HasProject, Converter={StaticResource InverseVisibility}}" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" FontSize="12" AutomationProperties.AutomationId="Status">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningInk}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"><Button Content="{Binding Text[UndoClean]}" Command="{Binding UndoRecentRemovalCommand}" IsEnabled="{Binding IsIdle}" Visibility="{Binding CanUndoRecentRemoval, Converter={StaticResource BoolVisibility}}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" AutomationProperties.AutomationId="UndoCleanRecent" /><Button Content="{Binding Text[ViewLog]}" Style="{StaticResource LinkButton}" Click="LogClick" /></StackPanel>
                <Button Grid.Column="2" Content="{Binding Text[Open]}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Style="{StaticResource Primary}" Width="144" MinHeight="42" VerticalAlignment="Center" AutomationProperties.AutomationId="Launch" />
            </Grid>
        </Border>
    </Grid>
</Window>
